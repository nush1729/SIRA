# Copy to .env and fill in. Nothing here is committed with real values — see
# smart-interview-scheduler-architecture.md Section 7.10 for what each of these costs.

# --- Core ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173

# --- Provider mode ---
# "sandbox" runs every external integration (Calendar/Meet/Email/SMS) against the Mock adapters —
# no external credentials required. Use this for local dev and for the judged demo.
# "live" requires every credential below to be set.
PROVIDER_MODE=sandbox

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_scheduler?schema=public

# --- Redis (booking lock + session/rate-limit counters) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Google OAuth + Calendar + Meet (free tier — see architecture doc 7.10) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# --- Email (SendGrid free tier: 100/day) ---
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# --- SMS (Twilio — paid, no ongoing free tier; optional channel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional AI layer (explanation text / message drafts / conversational assistant only — never decides conflicts) ---
ANTHROPIC_API_KEY=
AI_EXPLAIN_ENABLED=false
