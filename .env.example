# ---------------------------------------------------------------------------
# Core — enough to run the whole product offline.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-random-32-plus-character-string"

# Base URL used to build candidate links. Set this to whatever the candidate's
# browser can actually reach — a LAN IP or tunnel if they're on a phone.
APP_URL="http://localhost:3000"

# mock   → seeded CalendarBusy rows + emails recorded in the Notification table
# google → real Google Calendar events with Meet links + real Gmail sends
PROVIDER_MODE="mock"

# Use A's real engine. "true" falls back to the deterministic stub.
USE_ENGINE_STUB="false"

# Staff UI talks to the real API. "true" renders from fixtures instead.
NEXT_PUBLIC_MOCK_API="false"

# ---------------------------------------------------------------------------
# Google mode — only needed when PROVIDER_MODE=google.
# Missing values fall back to mock with a console warning rather than crashing.
#
# Setup, once:
#   1. console.cloud.google.com → new project
#   2. Enable "Google Calendar API" and "Gmail API"
#   3. OAuth consent screen → External → add yourself as a Test user
#   4. Credentials → OAuth client ID → Web application
#      Authorised redirect URI: http://localhost:3000/api/auth/google/callback
#   5. Mint a refresh token once with scopes:
#        https://www.googleapis.com/auth/calendar
#        https://www.googleapis.com/auth/gmail.send
#      (use OAuth Playground, or any one-off script, with access_type=offline)
#   6. Create the six secondary calendars and put their ids in User.calendarId
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_SENDER_EMAIL=""          # the master account address emails are sent from
GOOGLE_PRIMARY_CALENDAR_ID=""   # optional; defaults to "primary"
GOOGLE_REDIRECT_URI=""          # optional; only used when minting the token
